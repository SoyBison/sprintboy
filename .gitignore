# Secrets: these hold the discord, plex, anthropic, last.fm and qbittorrent
# credentials. Never commit them.
.env
.env.*

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyright/

# Local editor and agent settings, as opposed to shared project config
.claude/settings.local.json

# Runtime output
*.log
data/

# Albums staged for upload and the torrents made from them: gigabytes of
# media that has no business in git.
pre-upload/
*.torrent
